:"number","minimum":0},"tax_amount":{"type":"number","minimum":0},"net_amount":{"type":"number","minimum":0}}}}}}}},
  "security":[{"AnstayApiKey":[]}],
  "paths":{
    "/api/v1/health":{"get":{"security":[],"summary":"Gateway health and sealed/configured state"}},
    "/api/v1/catalog":{"get":{"summary":"Active villas, booking policies, channels, rate plans and mappings"}},
