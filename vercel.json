{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/booking",
      "destination": "/booking.html"
    },
    {
      "source": "/api/public/:path*",
      "destination": "https://anstay-booking-engine.vercel.app/api/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://anstay-channel-gateway.vercel.app/api/v1/:path*"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
